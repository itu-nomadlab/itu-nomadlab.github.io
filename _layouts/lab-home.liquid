---
layout: default
---
<div class="lab-home">
  <section class="lab-hero nomad-panel">
    <div class="lab-hero__copy">
      <h1 class="lab-hero__brand-title" tabindex="0" aria-label="İTÜ NomadLab. No Model Alone Decides.">
        <span class="lab-hero__brand-face lab-hero__brand-face--default" aria-hidden="true">
          <span class="lab-hero__brand-itu">İTÜ</span>
          <span class="lab-hero__brand-name">NomadLab</span>
        </span>
        <span class="lab-hero__brand-face lab-hero__brand-face--manifesto" aria-hidden="true">
          <span class="lab-hero__manifesto-line">
            <span class="lab-hero__manifesto-word"><span class="lab-hero__manifesto-initial">N</span><span>O</span></span>
            <span class="lab-hero__manifesto-word"><span class="lab-hero__manifesto-initial">M</span><span>ODEL</span></span>
          </span>
          <span class="lab-hero__manifesto-line">
            <span class="lab-hero__manifesto-word"><span class="lab-hero__manifesto-initial">A</span><span>LONE</span></span>
            <span class="lab-hero__manifesto-word"><span class="lab-hero__manifesto-initial">D</span><span>ECIDES.</span></span>
          </span>
        </span>
      </h1>
      <p class="lab-hero__lead">{{ site.data.site.short_description }}</p>
      <div class="hero-actions">
        <a class="lab-button lab-button--primary" href="{{ '/publications/' | relative_url }}">View publications <i class="ti ti-arrow-up-right"></i></a>
        <a class="lab-button lab-button--secondary" href="{{ '/people/' | relative_url }}">Meet the lab</a>
      </div>
    </div>

    <div class="lab-hero__map lab-hero__map--nomadic" aria-hidden="true">
      {% include nomadic-atlas.liquid %}
    </div>
  </section>

<section class="home-section home-split">
    <div class="home-split__main">
      <div class="section-heading section-heading--compact">
        <div>
          <p class="micro-label">Selected work</p>
          <h2>Publications</h2>
        </div>
        <a class="text-link" href="{{ '/publications/' | relative_url }}">Full list <i class="ti ti-arrow-right"></i></a>
      </div>
      <div class="publication-shell publication-shell--home">
        {% include selected_papers.liquid %}
      </div>
    </div>

    <aside class="home-split__aside nomad-panel">
      <p class="micro-label">Latest signal</p>
      {% assign latest_news = site.data.news | first %}
      <time datetime="{{ latest_news.date }}">{{ latest_news.date | date: '%d %b %Y' }}</time>
      <h3>{{ latest_news.title }}</h3>
      <p>{{ latest_news.text }}</p>
      {% if latest_news.url %}<a class="text-link" href="{{ latest_news.url | relative_url }}">Read signal <i class="ti ti-arrow-right"></i></a>{% endif %}
    </aside>
  </section>

  <section class="home-section home-join nomad-panel">
    <div>
      <p class="micro-label">Join the route</p>
      <h2>Bring a difficult question.</h2>
      <p>We welcome research collaborations, thesis projects, and motivated students whose interests intersect with our ongoing work.</p>
    </div>
    <a class="lab-button lab-button--primary" href="{{ '/join/' | relative_url }}">Work with NomadLab <i class="ti ti-arrow-up-right"></i></a>
  </section>
</div>

<script defer src="{{ '/assets/js/nomadic-atlas.js' | relative_url | bust_file_cache }}"></script>
