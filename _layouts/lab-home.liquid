---
layout: default
---
<div class="lab-home">
  <section class="lab-hero nomad-panel">
    <div class="lab-hero__copy">
      <p class="eyebrow"><span>NOMADLAB</span> / {{ site.institution | upcase }}</p>
      <h1
        class="nomad-acronym"
        tabindex="0"
        aria-label="Nomadic intelligence. Grounded science. NOMAD means: No Model Alone Decides."
      >
        <span class="nomad-acronym__face nomad-acronym__face--default" aria-hidden="true">
          Nomadic intelligence.<br>Grounded science.
        </span>
        <span class="nomad-acronym__face nomad-acronym__face--expanded" aria-hidden="true">
          <span class="nomad-acronym__line">
            <span class="nomad-acronym__word"><span class="nomad-acronym__key">NO</span></span>
            <span class="nomad-acronym__word"><span class="nomad-acronym__key">M</span>odel</span>
          </span>
          <span class="nomad-acronym__line">
            <span class="nomad-acronym__word"><span class="nomad-acronym__key">A</span>lone</span>
            <span class="nomad-acronym__word"><span class="nomad-acronym__key">D</span>ecides.</span>
          </span>
        </span>
      </h1>
      <p class="lab-hero__lead">{{ site.data.site.short_description }}</p>
      <div class="hero-actions">
        <a class="lab-button lab-button--primary" href="{{ '/research/' | relative_url }}">Explore our research <i class="ti ti-arrow-up-right"></i></a>
        <a class="lab-button lab-button--secondary" href="{{ '/people/' | relative_url }}">Meet the lab</a>
      </div>
    </div>

    <div class="lab-hero__map" aria-hidden="true">
      <div class="route-map">
        <span class="route-map__label route-map__label--a">ADAPT</span>
        <span class="route-map__label route-map__label--b">RETRIEVE</span>
        <span class="route-map__label route-map__label--c">VERIFY</span>
        <span class="route-map__label route-map__label--d">DISCOVER</span>
        <span class="route-map__node route-map__node--a"></span>
        <span class="route-map__node route-map__node--b"></span>
        <span class="route-map__node route-map__node--c"></span>
        <span class="route-map__node route-map__node--d"></span>
        <span class="route-map__path route-map__path--one"></span>
        <span class="route-map__path route-map__path--two"></span>
        <span class="route-map__path route-map__path--three"></span>
        <div class="route-map__mark">
          <span>N</span>
          <small>ISTANBUL<br>TÜRKİYE</small>
        </div>
      </div>
    </div>
  </section>

  {% assign publication_count = site.data.publications.order | size %}
  <section class="home-metrics" aria-label="NomadLab at a glance">
    <div><strong>04</strong><span>research routes</span></div>
    <div><strong>{% if publication_count < 10 %}0{% endif %}{{ publication_count }}</strong><span>publications</span></div>
    <div><strong>01</strong><span>experimental interface</span></div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="micro-label">Research routes</p>
        <h2>Questions that move with the world</h2>
      </div>
      <a class="text-link" href="{{ '/research/' | relative_url }}">All research <i class="ti ti-arrow-right"></i></a>
    </div>
    {% include research-grid.liquid show_questions=false %}
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="micro-label">Current work</p>
        <h2>Projects in motion</h2>
      </div>
      <a class="text-link" href="{{ '/projects/' | relative_url }}">All projects <i class="ti ti-arrow-right"></i></a>
    </div>
    <div class="project-grid project-grid--home">
      {% for project in site.data.projects.projects limit: 3 %}
        <article class="project-card nomad-panel">
          <div class="project-card__meta">
            <span class="project-card__code">{{ project.code }}</span>
            <span class="status-pill status-pill--{{ project.status }}">{{ project.status }}</span>
          </div>
          <h3>{{ project.title }}</h3>
          <p>{{ project.summary }}</p>
          <ul class="tag-list" aria-label="Topics for {{ project.title }}">
            {% for tag in project.tags %}<li>{{ tag }}</li>{% endfor %}
          </ul>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section home-split">
    <div class="home-split__main">
      <div class="section-heading section-heading--compact">
        <div>
          <p class="micro-label">Selected work</p>
          <h2>Publications</h2>
        </div>
        <a class="text-link" href="{{ '/publications/' | relative_url }}">Full list <i class="ti ti-arrow-right"></i></a>
      </div>
      <div class="publication-shell publication-shell--home">
        {% include selected_papers.liquid %}
      </div>
    </div>

    <aside class="home-split__aside nomad-panel">
      <p class="micro-label">Latest signal</p>
      {% assign latest_news = site.data.news | first %}
      <time datetime="{{ latest_news.date }}">{{ latest_news.date | date: '%d %b %Y' }}</time>
      <h3>{{ latest_news.title }}</h3>
      <p>{{ latest_news.text }}</p>
      {% if latest_news.url %}<a class="text-link" href="{{ latest_news.url | relative_url }}">Read signal <i class="ti ti-arrow-right"></i></a>{% endif %}
    </aside>
  </section>

  <section class="home-section home-join nomad-panel">
    <div>
      <p class="micro-label">Join the route</p>
      <h2>Bring a difficult question.</h2>
      <p>We welcome research collaborations, thesis projects, and motivated students whose interests intersect with our research routes.</p>
    </div>
    <a class="lab-button lab-button--primary" href="{{ '/join/' | relative_url }}">Work with NomadLab <i class="ti ti-arrow-up-right"></i></a>
  </section>
</div>
