---
layout: default
---
{% assign publication = site.data.publications.items[page.publication_id] %}
{% assign paper_url = page.paper_url | default: publication.paper_url %}
{% assign scholar_url = page.scholar_url | default: publication.scholar_url %}
{% assign code_url = page.code_url | default: publication.code_url %}
{% assign project_url = page.project_url | default: publication.project_url %}
<article class="publication-detail">
  <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="{{ '/publications/' | relative_url }}"><i class="ti ti-arrow-left" aria-hidden="true"></i> Publications</a></nav>

  <header class="publication-detail__hero nomad-panel">
    <div class="publication-detail__venue-row"><span class="publication-detail__venue">{{ publication.venue }}</span><span class="publication-detail__type">{{ publication.venue_type }}</span></div>
    <h1>{{ publication.title }}</h1>
    {% include publication-authors.liquid authors=publication.authors %}
  </header>

  <div class="publication-detail__grid">
    <section class="publication-detail__main nomad-panel">
      {% assign body_content = content | strip %}
      {% if body_content != '' %}
        <div class="publication-detail__content publication-summary">{{ content }}</div>
      {% else %}
        <div class="publication-summary__empty">
          <p class="micro-label">Research summary</p>
          <h2>Detailed summary coming soon.</h2>
          <p>This page is ready for a structured explanation with figures, equations, results, and implementation notes.</p>
        </div>
      {% endif %}
    </section>

    <aside class="publication-detail__side nomad-panel">
      <p class="micro-label">Publication details</p>
      <dl class="publication-metadata"><div><dt>Venue</dt><dd>{{ publication.venue }}</dd></div><div><dt>Type</dt><dd>{{ publication.venue_type }}</dd></div><div><dt>Authors</dt><dd>{{ publication.authors | size }}</dd></div></dl>
      <div class="publication-resources">
        <h2>Resources</h2>{% assign has_resource = false %}
        {% if paper_url %}{% assign has_resource = true %}<a class="lab-button lab-button--primary" href="{{ paper_url }}" target="_blank" rel="noopener"><i class="ti ti-file-type-pdf"></i> Paper</a>{% endif %}
        {% if scholar_url %}{% assign has_resource = true %}<a class="lab-button lab-button--secondary" href="{{ scholar_url }}" target="_blank" rel="noopener"><i class="ti ti-school"></i> Google Scholar</a>{% endif %}
        {% if code_url %}{% assign has_resource = true %}<a class="lab-button lab-button--secondary" href="{{ code_url }}" target="_blank" rel="noopener"><i class="ti ti-code"></i> Code</a>{% endif %}
        {% if project_url %}{% assign has_resource = true %}<a class="lab-button lab-button--secondary" href="{{ project_url }}" target="_blank" rel="noopener"><i class="ti ti-world"></i> Project</a>{% endif %}
        {% unless has_resource %}<p class="publication-resources__empty">Paper, code, and project links will appear here when they are available.</p>{% endunless %}
      </div>
    </aside>
  </div>
</article>
