{% assign people = include.members %}
<div class="people-grid">
  {% for person_id in people %}
    {% assign person = site.data.authors[person_id] %}
    {% if person %}
      {% assign nomad_pixel_columns = person.nomad_pixel_columns | default: 64 %}
      {% assign nomad_dither = person.nomad_dither | default: 20 %}
      {% assign nomad_threshold_shift = person.nomad_threshold_shift | default: 0 %}
      {% assign nomad_detail_recovery = person.nomad_detail_recovery | default: 1 %}
      <article class="person-card nomad-panel">
        {% if person.profile_url %}<a class="person-card__portrait-link" href="{{ person.profile_url | relative_url }}" aria-label="Open profile for {{ person.name }}">{% endif %}
          <div{% if person.image %} class="person-card__portrait nomad-portrait" data-nomad-portrait data-nomad-pixel-columns="{{ nomad_pixel_columns }}" data-nomad-dither="{{ nomad_dither }}" data-nomad-threshold-shift="{{ nomad_threshold_shift }}" data-nomad-detail-recovery="{{ nomad_detail_recovery }}"{% else %} class="person-card__portrait"{% endif %}>
            {% if person.image %}
              {% assign portrait_path = '/assets/img/' | append: person.image %}
              <img class="nomad-portrait__source" src="{{ portrait_path | relative_url }}" alt="{{ person.image_alt | default: person.name }}" loading="lazy">
              <canvas class="nomad-portrait__canvas" aria-hidden="true"></canvas>
            {% else %}
              <div class="person-card__initials" aria-hidden="true">{{ person.initials | default: person.name | slice: 0, 2 }}</div>
            {% endif %}
          </div>
        {% if person.profile_url %}</a>{% endif %}

        <div class="person-card__body">
          <p class="person-card__role">{{ person.role }}</p>
          <h3 class="person-card__name">{% if person.profile_url %}<a href="{{ person.profile_url | relative_url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}</h3>
          {% if person.bio %}<p class="person-card__bio">{{ person.bio }}</p>{% endif %}
          {% if person.interests %}<ul class="tag-list" aria-label="Research interests">{% for interest in person.interests %}<li>{{ interest }}</li>{% endfor %}</ul>{% endif %}
          <div class="person-card__links" aria-label="Links for {{ person.name }}">
            {% if person.profile_url %}<a href="{{ person.profile_url | relative_url }}"><i class="ti ti-user"></i><span>Profile</span></a>{% endif %}
            {% if person.email %}<a href="mailto:{{ person.email }}" aria-label="Email {{ person.name }}"><i class="ti ti-mail"></i><span>Email</span></a>{% endif %}
            {% if person.homepage %}<a href="{{ person.homepage }}" aria-label="Homepage of {{ person.name }}"><i class="ti ti-world"></i><span>Web</span></a>{% endif %}
            {% if person.scholar %}<a href="{{ person.scholar }}" aria-label="Google Scholar profile of {{ person.name }}"><i class="ai ai-google-scholar"></i><span>Scholar</span></a>{% endif %}
            {% if person.github %}<a href="{{ person.github }}" aria-label="GitHub profile of {{ person.name }}"><i class="ti ti-brand-github"></i><span>GitHub</span></a>{% endif %}
            {% if person.linkedin %}<a href="{{ person.linkedin }}" aria-label="LinkedIn profile of {{ person.name }}"><i class="ti ti-brand-linkedin"></i><span>LinkedIn</span></a>{% endif %}
          </div>
        </div>
      </article>
    {% endif %}
  {% endfor %}
</div>
