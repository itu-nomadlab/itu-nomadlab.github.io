{% assign author = site.data.authors[page.author_id] %}
{% assign profile_variant = include.profile_variant %}

<article class="author-profile author-profile--{{ profile_variant }}">
  <nav class="detail-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ '/people/' | relative_url }}"><i class="ti ti-arrow-left" aria-hidden="true"></i> People</a>
  </nav>

  <header class="author-profile__hero nomad-panel">
    <div{% if author.image %} class="author-profile__portrait nomad-portrait" data-nomad-portrait data-nomad-pixel-columns="30" data-nomad-dither="20"{% else %} class="author-profile__portrait"{% endif %}>
      {% if author.image %}
        {% assign portrait_path = '/assets/img/' | append: author.image %}
        <img class="nomad-portrait__source" src="{{ portrait_path | relative_url }}" alt="{{ author.image_alt | default: author.name }}">
        <canvas class="nomad-portrait__canvas" aria-hidden="true"></canvas>
      {% else %}
        <div class="author-profile__initials" aria-hidden="true">{{ author.initials | default: author.name | slice: 0, 2 }}</div>
      {% endif %}
    </div>

    <div class="author-profile__identity">
      <p class="micro-label">{% if profile_variant == 'undergraduate' %}Undergraduate author{% else %}Graduate author{% endif %}</p>
      <h1>{{ author.name }}</h1>
      <p class="author-profile__role">{{ author.role }}</p>
      {% if author.affiliation %}<p class="author-profile__affiliation">{{ author.affiliation }}</p>{% endif %}
      {% if author.bio %}<p class="author-profile__bio">{{ author.bio }}</p>{% endif %}

      {% if author.interests %}
        <ul class="tag-list" aria-label="Research interests">
          {% for interest in author.interests %}<li>{{ interest }}</li>{% endfor %}
        </ul>
      {% endif %}

      {% if author.email %}
        <div class="author-profile__links">
          <a class="lab-button lab-button--secondary" href="mailto:{{ author.email }}"><i class="ti ti-mail"></i> Email</a>
        </div>
      {% endif %}
    </div>
  </header>

  {% if profile_variant == 'undergraduate' %}
    <section class="author-artifact nomad-panel">
      <div class="author-artifact__heading">
        <div><p class="micro-label">Graduation project</p><h2>Poster</h2></div>
        <span class="author-artifact__kind">PDF</span>
      </div>
      {% if author.poster.title %}<h3>{{ author.poster.title }}</h3>{% endif %}
      {% if author.poster.available and author.poster.pdf %}
        <p>The graduation-project poster is available as a PDF.</p>
        <a class="lab-button lab-button--primary" href="{{ author.poster.pdf | relative_url }}" target="_blank" rel="noopener">Open poster PDF <i class="ti ti-file-type-pdf"></i></a>
      {% else %}
        <div class="artifact-placeholder">
          <i class="ti ti-file-type-pdf" aria-hidden="true"></i>
          <div><strong>Poster PDF has not been uploaded yet.</strong><p>Add the file at <code>{{ author.poster.pdf }}</code>, then set <code>available: true</code> in <code>_data/authors.yml</code>.</p></div>
        </div>
      {% endif %}
    </section>
  {% else %}
    <section class="author-artifact nomad-panel">
      <div class="author-artifact__heading">
        <div><p class="micro-label">Graduate record</p><h2>Thesis</h2></div>
        <span class="author-artifact__kind">PDF</span>
      </div>
      {% if author.thesis.title %}<h3>{{ author.thesis.title }}</h3>{% endif %}
      {% if author.thesis.degree or author.thesis.institution or author.thesis.year %}
        <p class="author-artifact__meta">
          {% if author.thesis.degree %}{{ author.thesis.degree }}{% endif %}
          {% if author.thesis.institution %}<span>{{ author.thesis.institution }}</span>{% endif %}
          {% if author.thesis.year %}<span>{{ author.thesis.year }}</span>{% endif %}
        </p>
      {% endif %}
      {% if author.thesis.available and author.thesis.pdf %}
        <p>The graduate thesis is available as a PDF.</p>
        <a class="lab-button lab-button--primary" href="{{ author.thesis.pdf | relative_url }}" target="_blank" rel="noopener">Open thesis PDF <i class="ti ti-file-type-pdf"></i></a>
      {% else %}
        <div class="artifact-placeholder">
          <i class="ti ti-file-type-pdf" aria-hidden="true"></i>
          <div><strong>Thesis information and PDF have not been uploaded yet.</strong><p>Complete the thesis fields in <code>_data/authors.yml</code>, add the PDF at <code>{{ author.thesis.pdf }}</code>, and set <code>available: true</code>.</p></div>
        </div>
      {% endif %}
    </section>
  {% endif %}

  <section class="author-publications-section">
    <div class="section-heading section-heading--compact">
      <div><p class="micro-label">Research record</p><h2>Publications</h2></div>
      <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <i class="ti ti-arrow-right"></i></a>
    </div>
    {% include author-publications.liquid author_id=page.author_id %}
  </section>
</article>
